<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{siteTitle}} - Next-Gen Event Engine</title>
    <meta name="description" content="Framework-free event management, registration, and dynamic API engine.">

    {{> base }}

</head>
<body>
    {{> header }}

    <main>
        <section class="hero">
            <div class="hero-badge">⚡ Handlebars SSR + PHP API Engine</div>
            <h1>{{heroTitle}}</h1>
            <p>{{heroSubtitle}}</p>
        </section>

        <section class="stats-grid">
            {{#each stats}}
            <div class="stat-card">
                <div class="stat-number">{{value}}</div>
                <div class="stat-label">{{label}}</div>
            </div>
            {{/each}}
        </section>

        <div class="section-title" id="events">
            <h2>Featured Events</h2>
            <span style="color: var(--text-muted); font-size: 0.9rem;">Server-Side Rendered via Handlebars</span>
        </div>

        <section class="events-grid">
            {{#each events}}
            <div class="event-card">
                <div class="event-header">
                    <span class="event-tag {{#if isLive}}tag-active{{else}}tag-upcoming{{/if}}">
                        {{status}}
                    </span>
                    <span class="event-date">{{date}}</span>
                </div>
                <div class="event-body">
                    <h3>{{title}}</h3>
                    <p>{{description}}</p>
                </div>
                <div class="event-footer">
                    <span class="event-location">📍 {{location}}</span>
                    <span class="event-capacity">{{attendees}} attendees</span>
                </div>
            </div>
            {{/each}}
        </section>

        <div class="section-title" id="architecture">
            <h2>Hybrid Monorepo Stack</h2>
        </div>

        <section class="tech-box">
            <div class="tech-item">
                <h4>Backend Engine</h4>
                <p>Framework-free, high-performance PHP API routed via <code>/_*</code> endpoints with dynamic controller resolution.</p>
            </div>
            <div class="tech-item">
                <h4>Website Engine</h4>
                <p>Server-side rendered Handlebars templates compiled dynamically for fast public page delivery.</p>
            </div>
            <div class="tech-item">
                <h4>Frontend SPA</h4>
                <p>Vue.js SPA management interface isolated under <code>/app/*</code> with static production builds in <code>frontend/dist</code>.</p>
            </div>
        </section>
    </main>

    {{> footer }}
</body>
</html>
